{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": "User ID=postgres;Password=postgres;Host=localhost;Port=5433;Database=ultra_bd"
  },
  "NLog": {
    "internalLogLevel": "Info",
    "internalLogFile": "C:\\Users\\Дмитрий\\...\\logs\\internal-nlog.txt",
    "extensions": [
      { "assembly": "NLog.Extensions.Logging" },
      { "assembly": "NLog.Web.AspNetCore" }
    ],
    "targets": {
      "my-file": {
        "type": "File",
        "fileName": "C:\\Users\\Дмитрий\\...\\logs\\logfile-${shortdate}.log",
        "layout": "${longdate}|${event-properties:item=EventId_Id}|${uppercase:${level}}|${logger}|${message} ${exception:format=tostring}|url: ${aspnet-request-url}|action: ${aspnet-mvc-action}"
      },
      "my-console": {
        "type": "ColoredConsole",
        "layout": "${longdate}|${uppercase:${level}}|${logger}|${message} ${exception:format=tostring}"
      }
    },
    "rules": [
      {
        "logger": "*",
        "minLevel": "Error",
        "writeTo": "my-file,my-console"
      },
      {
        "logger": "*",
        "minLevel": "Info",
        "writeTo": "my-console"
      }
    ]
  }
}
